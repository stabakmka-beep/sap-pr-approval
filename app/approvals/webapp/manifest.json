{
  "_version": "1.65.0",
  "sap.app": {
    "id": "pr.approvals",
    "type": "application",
    "title": "Approvals",
    "description": "Approve or reject purchase requests waiting on your role.",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "main": {
        "uri": "/odata/v4/approver/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "manage": {
          "semanticObject": "PurchaseRequest",
          "action": "approve",
          "title": "Approvals",
          "icon": "sap-icon://approvals",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "purchase.request"
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.core": {},
        "sap.fe.templates": {},
        "sap.f": {}
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "": {
        "dataSource": "main",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        { "pattern": ":?query:", "name": "PurchaseRequestsList", "target": ["PurchaseRequestsList"] },
        { "pattern": "PurchaseRequests({key}):?query:", "name": "PurchaseRequestsObjectPage", "target": ["PurchaseRequestsList", "PurchaseRequestsObjectPage"] }
      ],
      "targets": {
        "PurchaseRequestsList": {
          "type": "Component",
          "id": "PurchaseRequestsList",
          "name": "sap.fe.templates.ListReport",
          "controlAggregation": "beginColumnPages",
          "options": {
            "settings": {
              "entitySet": "PurchaseRequests",
              "contextPath": "/PurchaseRequests",
              "initialLoad": "Enabled",
              "variantManagement": "None",
              "navigation": {
                "PurchaseRequests": { "detail": { "route": "PurchaseRequestsObjectPage" } }
              }
            }
          }
        },
        "PurchaseRequestsObjectPage": {
          "type": "Component",
          "id": "PurchaseRequestsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "controlAggregation": "midColumnPages",
          "contextPattern": "/PurchaseRequests({key})",
          "options": {
            "settings": {
              "entitySet": "PurchaseRequests",
              "contextPath": "/PurchaseRequests",
              "editableHeaderContent": false
            }
          }
        }
      },
      "config": {
        "flexibleColumnLayout": {
          "defaultTwoColumnLayoutType": "TwoColumnsMidExpanded",
          "defaultThreeColumnLayoutType": "ThreeColumnsMidExpanded"
        },
        "routerClass": "sap.f.routing.Router"
      }
    },
    "rootView": {
      "viewName": "sap.fe.core.rootView.Fcl",
      "type": "XML",
      "async": true,
      "id": "appRootView"
    }
  },
  "sap.fiori": {
    "registrationIds": ["pr.approvals"],
    "archeType": "transactional"
  }
}
